# ─────────────────────────────────────────────────────────────
# PushNotify — environment for docker-compose
# Copy to .env and adjust. All values have safe dev defaults.
# ─────────────────────────────────────────────────────────────

# Auth — REQUIRED in production (long random string)
JWT_SECRET=dev-secret-change-me

# Public URL the dashboard uses to reach the API (browser-facing)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public dashboard URL (used by the server for Stripe redirect URLs)
APP_URL=http://localhost:3000

# ─── Billing (Stripe) ─────────────────────────────────────────
# Leave empty to disable billing (workspaces stay on the free plan).
# Get these from https://dashboard.stripe.com (use test keys first).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_ID=

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PushNotify <no-reply@pushnotify.dev>

# ─── WhatsApp (Evolution API / Z-API) ─────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ─── SMS (Twilio) ─────────────────────────────────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
