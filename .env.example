# ─────────────────────────────────────────────────────────────
# PushNotify — environment for docker-compose
# Copy to .env and adjust. All values have safe dev defaults.
# ─────────────────────────────────────────────────────────────

# Auth — REQUIRED in production (long random string)
JWT_SECRET=dev-secret-change-me

# Public URL the dashboard uses to reach the API (browser-facing)
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PushNotify <no-reply@pushnotify.dev>

# ─── WhatsApp (Evolution API / Z-API) ─────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ─── SMS (Twilio) ─────────────────────────────────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
