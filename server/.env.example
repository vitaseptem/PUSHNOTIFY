# ─── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ─── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgres://pushnotify:pushnotify@postgres:5432/pushnotify?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=20

# ─── JWT auth ─────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=24h

# ─── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PushNotify <no-reply@pushnotify.dev>

# ─── WhatsApp (Evolution API / Z-API) ─────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ─── SMS (Twilio) ─────────────────────────────────────────
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ─── Queue / workers ──────────────────────────────────────
QUEUE_WORKERS=10
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE=30

# ─── Billing (Stripe) ─────────────────────────────────────
# Public dashboard URL for Stripe redirect URLs.
APP_URL=http://localhost:3000
# Leave the Stripe values empty to disable billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_ID=
